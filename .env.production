# Production build values. Tracked in git (unlike .env) so a deploy flips
# to the live App Store CTAs on push alone, without depending on the host's
# dashboard being configured. Only PUBLIC values belong here — every VITE_*
# var is inlined into the client bundle. Secrets (waitlist API key, endpoint)
# stay in the host's environment settings.

# Reembr is out on the App Store, so the CTAs are the real download buttons.
VITE_LAUNCH_MODE=live

# https://apps.apple.com/us/app/reembr/id6777085237
VITE_APP_STORE_URL=https://apps.apple.com/us/app/reembr/id6777085237
